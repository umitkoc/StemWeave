{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StemWeave Music Center",
  "version": "0.1.0",
  "identifier": "org.stemweave.center",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StemWeave Music Center",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["main-capability"],
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:3000 http://localhost:3000; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
