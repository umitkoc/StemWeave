{
  "name": "@stemweave/piano-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "clean": "node ../../scripts/clean-package.mjs",
    "dev": "expo start",
