# Yerel geliştirme ortamı için örnek değişkenler
# Bu dosyayı kopyalayarak .env isimli bir dosya oluşturun

# Veritabanı
DATABASE_URL="postgres://postgres:postgres@localhost:5432/stemweave"

# Uygulama
NODE_ENV="development"
PORT="3000"

# Music Center — yalnız development auth adaptörü içindir; production kimliği değildir
VITE_API_BASE_URL="http://127.0.0.1:3000"
VITE_DEV_USER_ID="11111111-1111-4111-8111-111111111111"
VITE_DEV_USER_EMAIL="conductor@stemweave.local"
VITE_DEV_DISPLAY_NAME="Yerel Şef"

# Asset (Ses dosyaları) saklama
# Geliştirme ortamında bu dizin Docker volume (stemweave-local-assets) veya host'taki klasör ile eşleşir
LOCAL_ASSET_PATH="./.local-assets"
